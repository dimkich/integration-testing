<?xml version='1.1' encoding='UTF-8'?>
<!-- @formatter:off -->
<test type="Container">
    <test type="Container" name="mockInvoke">
        <mockInvoke name="converter" method="convertToString">
            <arg type="Integer">1</arg>
            <result>
                <return>1</return>
            </result>
            <result>
                <return>2</return>
            </result>
            <result>
                <throw type="HttpClientErrorException.BadRequest">
                    <statusCode>BAD_REQUEST</statusCode>
                    <rawStatusCode>400</rawStatusCode>
                    <message>Not supported yet.</message>
                </throw>
            </result>
            <result>
                <return>4</return>
            </result>
        </mockInvoke>
        <test type="Case" name="1">
            <bean>converter</bean>
            <method>convertToString</method>
            <request type="Integer">1</request>
            <response>1</response>
        </test>
        <test type="Case" name="2">
            <bean>converter</bean>
            <method>convertToString</method>
            <request type="Integer">1</request>
            <response>2</response>
        </test>
        <test type="Case" name="3">
            <bean>converter</bean>
            <method>convertToString</method>
            <request type="Integer">1</request>
            <response type="HttpClientErrorException.BadRequest">
                <statusCode>BAD_REQUEST</statusCode>
                <rawStatusCode>400</rawStatusCode>
                <message>Not supported yet.</message>
            </response>
        </test>
        <test type="Case" name="4">
            <bean>converter</bean>
            <method>convertToString</method>
            <request type="Integer">1</request>
            <response>4</response>
        </test>
        <test type="Case" name="5">
            <bean>converter</bean>
            <method>convertToString</method>
            <request type="Integer">1</request>
            <response>1</response>
        </test>
    </test>
    <test type="Container" name="argument equality">
        <mockInvoke name="converter" method="charge">
            <arg type="BigDecimal">0.2</arg>
            <result>
                <return>wrong</return>
            </result>
        </mockInvoke>
        <mockInvoke name="converter" method="charge">
            <arg type="BigDecimal">0.1</arg>
            <result>
                <return>right</return>
            </result>
        </mockInvoke>
        <mockInvoke name="converter" method="amount">
            <arg type="Amount">
                <value>0.2</value>
            </arg>
            <result>
                <return>wrong</return>
            </result>
        </mockInvoke>
        <mockInvoke name="converter" method="amount">
            <arg type="Amount">
                <value>0.1</value>
            </arg>
            <result>
                <return>right</return>
            </result>
        </mockInvoke>
        <mockInvoke name="converter" method="sorted">
            <arg type="SortedBook">
                <bid key="0.2">12.3</bid>
            </arg>
            <result>
                <return>wrong</return>
            </result>
        </mockInvoke>
        <mockInvoke name="converter" method="sorted">
            <arg type="SortedBook">
                <bid key="0.1">12.3</bid>
            </arg>
            <result>
                <return>right</return>
            </result>
        </mockInvoke>
        <mockInvoke name="converter" method="unordered">
            <arg type="UnorderedBook">
                <entry key="0.1">other</entry>
            </arg>
            <result>
                <return>wrong</return>
            </result>
        </mockInvoke>
        <mockInvoke name="converter" method="unordered">
            <arg type="UnorderedBook">
                <entry key="0.1">first</entry>
            </arg>
            <result>
                <return>right</return>
            </result>
        </mockInvoke>
        <test type="Case" name="bigDecimal scalar">
            <bean>converter</bean>
            <method>charge</method>
            <request type="BigDecimal">0.1000</request>
            <response>right</response>
        </test>
        <test type="Case" name="bigDecimal field">
            <bean>converter</bean>
            <method>amount</method>
            <request type="Amount">
                <value>0.1000</value>
            </request>
            <response>right</response>
        </test>
        <test type="Case" name="bigDecimal keys of sorted map">
            <bean>converter</bean>
            <method>sorted</method>
            <request type="SortedBook">
                <bid key="0.10">12.300</bid>
            </request>
            <response>right</response>
        </test>
        <test type="Case" name="bigDecimal keys of unordered map">
            <bean>converter</bean>
            <method>unordered</method>
            <request type="UnorderedBook">
                <entry key="0.10">first</entry>
            </request>
            <response>right</response>
        </test>
    </test>
</test>
